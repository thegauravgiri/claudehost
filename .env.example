# Copy to .env and fill in real values. Never commit .env.
LITELLM_MASTER_KEY=sk-CHANGE-ME-long-random-string
LITELLM_SALT_KEY=sk-CHANGE-ME-long-random-string
POSTGRES_PASSWORD=CHANGE-ME

# Shared secret between litellm and runner
CLAUDEBOX_API_MODE_TOKEN=CHANGE-ME

# The default Claude account, from: claude setup-token (shares one subscription's
# rate limits/ToS across all callers). More accounts: see claude-accounts.env.example
CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-CHANGE-ME

CLAUDEBOX_GIT_NAME=Claude Bot
CLAUDEBOX_GIT_EMAIL=claude-bot@example.com
