# Copy to .env and fill in real values. Never commit .env.
LITELLM_MASTER_KEY=sk-CHANGE-ME-long-random-string
LITELLM_SALT_KEY=sk-CHANGE-ME-long-random-string
POSTGRES_PASSWORD=CHANGE-ME

# Shared secret between litellm and the runner
CLAUDEBOX_API_MODE_TOKEN=CHANGE-ME

# From: claude setup-token (shares one subscription's rate limits/ToS across all callers)
CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-CHANGE-ME

CLAUDEBOX_GIT_NAME=Claude Bot
CLAUDEBOX_GIT_EMAIL=claude-bot@example.com

# Jira-driven coding agent + CodeRabbit auto-fix loop (orchestrator/).
# Optional - only needed if you use either.

# A virtual key minted for the orchestrator itself, scoped to the runner models.
ORCHESTRATOR_LITELLM_KEY=sk-CHANGE-ME

# From: github.com/settings/personal-access-tokens - fine-grained PAT on a
# machine user (not your own account: the auto-fix loop @-mentions the PR
# author when it's done, which does nothing if the PAT's own account is the
# author), scoped to Contents: read/write + Pull requests: read/write +
# Issues: read/write + Metadata: read + Checks: read + Actions: read,
# limited to the repos in orchestrator/repos.yaml. The last two are only
# needed for the CI half of the auto-fix loop (reading check-run results
# and job logs); drop them if you only use the CodeRabbit half.
GH_TOKEN=github_pat_CHANGE-ME

# Random secret shared with the GitHub webhook config. One webhook covers
# the Jira flow's PR-closed cleanup and both halves of the auto-fix loop;
# see README for which events to subscribe to.
GH_WEBHOOK_SECRET=CHANGE-ME

# The CodeRabbit bot's GitHub login - only webhook events authored by this
# account drive the auto-fix loop. Default matches CodeRabbit's own app.
CODERABBIT_LOGIN=coderabbitai[bot]

# Give up and @-mention the PR author for human help after this many fix
# rounds on one PR, instead of looping forever against a stuck review.
CODERABBIT_MAX_ITERATIONS=5

# How long to wait for the *other* half (CodeRabbit or CI) to also report
# in before fixing just the one that has, once a PR is armed with "/agent
# go" and either CodeRabbit or CI reports back on a commit. Keeps a repo
# that only has one of the two from waiting forever for the other.
CODERABBIT_CI_COMBINE_WAIT_SECONDS=300

# The GitHub App slug for the CI checks to react to - only needed if your
# CI isn't GitHub Actions itself (this module can only fetch job logs
# through the Actions API, so other check providers are ignored either way).
CI_CHECK_APP_SLUG=github-actions

# How long an Actions run can sit queued/in_progress before a fix round
# gives up on it, cancels it via the API, and runs its own full test suite
# instead of waiting - protects against a CI run that's genuinely hung
# (vs. just slow). Each fix round also skips re-running its own browser/E2E
# tests when CI already passed cleanly on the exact commit it's working
# from, trusting CI to re-check the commit it's about to push.
CI_STUCK_SECONDS=900

# How long a single agent call (runner's shell subprocess) gets to clone,
# install dependencies, run a project's own test suite, and push, before
# it's cut off - shared by the runner (its own internal subprocess timeout)
# and the orchestrator (which sends this value to runner per-request and
# waits a little longer than it for the response). Raise this if a repo's
# own test suite (Docker-based, real browser tests, etc.) is heavier than
# the default comfortably covers.
AGENT_TIMEOUT_SECONDS=3600

# e.g. https://your-domain.atlassian.net
JIRA_BASE_URL=https://CHANGE-ME.atlassian.net

# From: id.atlassian.com/manage-profile/security/api-tokens - the account
# JIRA_API_TOKEN authenticates as; comments are posted under this identity.
JIRA_EMAIL=CHANGE-ME@example.com
JIRA_API_TOKEN=CHANGE-ME

# Random secret shared with the Jira webhook (Automation rule) config.
JIRA_WEBHOOK_SECRET=CHANGE-ME
