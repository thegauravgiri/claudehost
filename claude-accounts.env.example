# Copy to claude-accounts.env (git-ignored) to add Claude subscriptions.
# CLAUDE_CODE_OAUTH_TOKEN in .env stays the "default" account, so existing
# model names keep working. Each line below adds an account named after the
# suffix, lowercased: CLAUDE_OAUTH_TOKEN_MCM -> account "mcm".
# Generate a token per subscription with `claude setup-token`.
#CLAUDE_OAUTH_TOKEN_MCM=sk-ant-oat01-...
#CLAUDE_OAUTH_TOKEN_ACME=sk-ant-oat01-...
